# Hai dòng cross-origin isolation, đúng thứ `serve.py` gửi khi chạy ở nhà.
# Đảo GƯƠNG VÔ CỰC chạy Python trong Web Worker và cần SharedArrayBuffer để
# lệnh `input()` biết dừng lại chờ; trình duyệt chỉ cho dùng SharedArrayBuffer
# khi trang được "cross-origin isolated".
#
# `credentialless` (chứ không phải `require-corp`) để mấy file tải từ CDN
# (Pyodide, MediaPipe, three.js) vẫn vào được mà không cần header CORP của họ.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# Bài của học sinh nằm ở đây; sửa xong bấm R là phải thấy bản mới ngay.
/student/*
  Cache-Control: no-store

/pygrade/*
  Cache-Control: no-store

# Mã trang: mặc định của Pages là giữ 4 tiếng, nên sau khi cập nhật, trình duyệt
# vẫn nạp file cũ và vỡ ngay chỗ import (đúng lỗi đã gặp: "does not provide an
# export named baseFor" trong khi file trên máy chủ đã có).
#
# Dùng `no-store` chứ không phải `no-cache`: đã đo trên chính site này, rule
# `no-cache` không có tác dụng (vẫn trả về max-age=14400), còn `no-store` thì có.
/src/*
  Cache-Control: no-store

/*.html
  Cache-Control: no-store

/
  Cache-Control: no-store

# Dấu bản dựng: trang tải file này để biết máy có đang giữ bản cũ không.
/build.txt
  Cache-Control: no-store
  Content-Type: text/plain; charset=utf-8
